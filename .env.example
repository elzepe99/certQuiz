# Copy to .env.local and fill in. `.env.local` is gitignored via the `*.local`
# rule, so your values stay out of the repo.
#
# Both values are already public — they ship inside the built JS bundle, and
# access is governed by Row Level Security rather than by keeping them secret.
# Find them in the Supabase dashboard under Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
